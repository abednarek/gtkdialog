SHOWCASE_RECENT_URI=file://$SHOWCASE_RECENT_DOCUMENT
SHOWCASE_RECENT_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-recent.txt
SHOWCASE_JSON_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-tree.json
SHOWCASE_SCROLL_LOG=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-scroll-$$.log
SHOWCASE_STATE_RESULT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-state-$$.txt
SHOWCASE_TERMINAL_DEMO=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-demo-$$.sh
SHOWCASE_TERMINAL_EXIT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-exit-$$.sh
SHOWCASE_TERMINAL_FEED=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-feed-$$.sh
SHOWCASE_TERMINAL_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-status-$$.txt
SHOWCASE_STATUS_ICON_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-status-icon-$$.txt
SHOWCASE_STATUS_ICON_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-status-icon-output-$$.txt
SHOWCASE_CURVE_LINEAR_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-curve-linear-$$.txt
SHOWCASE_CURVE_SPLINE_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-curve-spline-$$.txt
SHOWCASE_CURVE_FREE_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-curve-free-$$.txt
SHOWCASE_SOURCE_C_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-source-$$.c
SHOWCASE_SOURCE_XML_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-source-$$.xml
SHOWCASE_SOURCE_C_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-source-c-$$.txt
SHOWCASE_SOURCE_XML_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-source-xml-$$.txt
SHOWCASE_DATABOX_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-databox-$$.txt
SHOWCASE_DATABOX_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-databox-output-$$.txt
SHOWCASE_DATABOX_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-databox-status-$$.txt
SHOWCASE_SHEET_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-sheet-$$.txt
SHOWCASE_SHEET_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-sheet-output-$$.txt
SHOWCASE_SHEET_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-sheet-status-$$.txt
SHOWCASE_DOCK_LAYOUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-dock-layout-$$.xml
SHOWCASE_DOCK_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-dock-status-$$.txt
SHOWCASE_OBJECT_SCENE=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-object-scene-$$.json
SHOWCASE_OBJECT_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-object-output-$$.json
SHOWCASE_OBJECT_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-object-status-$$.txt
SHOWCASE_TASKLIST_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-tasklist-$$.txt
SHOWCASE_TASKLIST_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-tasklist-status-$$.txt
SHOWCASE_PAGER_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-pager-$$.txt
SHOWCASE_PAGER_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-pager-status-$$.txt
SHOWCASE_WINDOWSELECTOR_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-windowselector-$$.txt
SHOWCASE_WINDOWSELECTOR_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-windowselector-status-$$.txt
SHOWCASE_OFFSCREEN_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-offscreen-$$.png
SHOWCASE_OFFSCREEN_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-offscreen-status-$$.txt
SHOWCASE_PAGE_SETUP_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-page-setup-$$.ini
SHOWCASE_PRINT_SETTINGS_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-print-settings-$$.ini
SHOWCASE_PAGE_SETUP_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-page-setup-status-$$.txt
SHOWCASE_PRINTER_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-printer-$$.txt
SHOWCASE_PRINT_DIALOG_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-print-dialog-status-$$.txt
SHOWCASE_FILE_DIALOG_DIR=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-$$
SHOWCASE_FILE_DIALOG_SELECTION=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-selection-$$.txt
SHOWCASE_FILE_DIALOG_RESPONSE=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-response-$$.txt
SHOWCASE_FILE_DIALOG_FOLDER=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-folder-$$.txt
SHOWCASE_FILE_DIALOG_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-status-$$.txt
SHOWCASE_FILE_DIALOG_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-input-$$.txt
SHOWCASE_FILE_DIALOG_URI_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-file-dialog-uri-$$.txt
