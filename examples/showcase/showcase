SHOWCASE_OUTPUT_DIR=${TMPDIR:-/tmp}
SHOWCASE_CELL_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-cellview.txt
SHOWCASE_CANVAS_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-canvas.png
SHOWCASE_IMAGEVIEW_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-imageview.png
SHOWCASE_CHOOSER_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-chooser.txt
