#!/bin/sh

[ -z "$GTKDIALOG" ] && GTKDIALOG=gtkdialog

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SHOWCASE_IMAGE=$script_dir/../../data/icons/hicolor/32x32/apps/gtkdialog.png
SHOWCASE_CANVAS_IMAGE=$script_dir/../playmusic/cover.png
SHOWCASE_PLAY_ICON=$script_dir/../playmusic/playmusic64.png
SHOWCASE_PROFILE_IMAGE=$script_dir/../pfeme/pfeme48.png
SHOWCASE_OUTPUT_DIR=${TMPDIR:-/tmp}
SHOWCASE_CELL_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-cellview.txt
SHOWCASE_CANVAS_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-canvas.png
SHOWCASE_CHOOSER_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-chooser.txt
SHOWCASE_CHOOSER_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-chooser-input-$$.txt
SHOWCASE_CHOOSER_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-chooser-status-$$.txt
SHOWCASE_ICON_LIST=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-icon-list-$$.txt
SHOWCASE_ICON_COMMAND_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-icon-command-$$.txt
SHOWCASE_ICON_FILE_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-icon-file-$$.txt
SHOWCASE_MENU_STATE=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-menu-state-$$.txt
SHOWCASE_MENU_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-menu-output-$$.txt
SHOWCASE_TOOL_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-tool-output-$$.txt
SHOWCASE_MENU_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-menu-status-$$.txt
SHOWCASE_RECENT_DATA=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-recent-data-$$
SHOWCASE_RECENT_DOCUMENT=$SHOWCASE_RECENT_DATA/recent-document.txt
SHOWCASE_RECENT_URI=file://$SHOWCASE_RECENT_DOCUMENT
SHOWCASE_RECENT_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-recent.txt
SHOWCASE_JSON_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-tree.json
SHOWCASE_SCROLL_LOG=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-scroll-$$.log
SHOWCASE_STATE_RESULT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-state-$$.txt
SHOWCASE_TERMINAL_DEMO=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-demo-$$.sh
SHOWCASE_TERMINAL_EXIT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-exit-$$.sh
SHOWCASE_TERMINAL_FEED=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-feed-$$.sh
SHOWCASE_TERMINAL_STATUS=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-terminal-status-$$.txt
SHOWCASE_STATUS_ICON_INPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-status-icon-$$.txt
SHOWCASE_STATUS_ICON_OUTPUT=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-status-icon-output-$$.txt
SHOWCASE_PLUG_LAUNCHER=$SHOWCASE_OUTPUT_DIR/gtkdialog-showcase-plug-$$.sh
SHOWCASE_GTKDIALOG=$GTKDIALOG
export SHOWCASE_IMAGE SHOWCASE_CANVAS_IMAGE SHOWCASE_PLAY_ICON SHOWCASE_PROFILE_IMAGE
export SHOWCASE_CELL_OUTPUT SHOWCASE_CANVAS_OUTPUT
export SHOWCASE_CHOOSER_OUTPUT SHOWCASE_CHOOSER_INPUT SHOWCASE_CHOOSER_STATUS
export SHOWCASE_ICON_LIST SHOWCASE_ICON_COMMAND_OUTPUT SHOWCASE_ICON_FILE_OUTPUT
export SHOWCASE_MENU_STATE SHOWCASE_MENU_OUTPUT SHOWCASE_TOOL_OUTPUT SHOWCASE_MENU_STATUS
export SHOWCASE_RECENT_DOCUMENT SHOWCASE_RECENT_URI SHOWCASE_RECENT_OUTPUT
export SHOWCASE_JSON_OUTPUT
export SHOWCASE_SCROLL_LOG SHOWCASE_STATE_RESULT
export SHOWCASE_TERMINAL_DEMO SHOWCASE_TERMINAL_EXIT SHOWCASE_TERMINAL_FEED
export SHOWCASE_TERMINAL_STATUS
export SHOWCASE_STATUS_ICON_INPUT SHOWCASE_STATUS_ICON_OUTPUT
export SHOWCASE_PLUG_LAUNCHER SHOWCASE_GTKDIALOG

: > "$SHOWCASE_SCROLL_LOG"
showcase_line=1
while [ "$showcase_line" -le 40 ]; do
	printf '%02d  Existing application log entry\n' "$showcase_line" \
		>> "$SHOWCASE_SCROLL_LOG"
	showcase_line=$((showcase_line + 1))
done
printf '%s\n' 'Target is sensitive and visible' > "$SHOWCASE_STATE_RESULT"
printf '%s\n' '/etc/hosts' > "$SHOWCASE_CHOOSER_INPUT"
printf '%s\n' 'Chooser is ready; activate or select a file' > "$SHOWCASE_CHOOSER_STATUS"
printf '%s\n' "$SHOWCASE_IMAGE" "$SHOWCASE_CANVAS_IMAGE" \
	"$SHOWCASE_PLAY_ICON" "$SHOWCASE_PROFILE_IMAGE" > "$SHOWCASE_ICON_LIST"
printf '%s\n' true > "$SHOWCASE_MENU_STATE"
printf '%s\n' 'The shared input file initially contains true' > "$SHOWCASE_MENU_STATUS"
mkdir "$SHOWCASE_RECENT_DATA" || exit 1
printf '%s\n' 'A deterministic recent document for the GTK2 showcase.' \
	> "$SHOWCASE_RECENT_DOCUMENT"
printf '%s\n' \
	'<?xml version="1.0" encoding="UTF-8"?>' \
	'<xbel version="1.0" xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">' \
	"  <bookmark href=\"$SHOWCASE_RECENT_URI\" added=\"2026-09-14T00:00:00Z\" modified=\"2026-09-14T00:00:00Z\" visited=\"2026-09-14T00:00:00Z\">" \
	'    <info><metadata owner="http://freedesktop.org"><mime:mime-type type="text/plain"/><bookmark:applications><bookmark:application name="gtkdialog-showcase" exec="&apos;gtkdialog-showcase %u&apos;" modified="2026-09-14T00:00:00Z" count="1"/></bookmark:applications></metadata></info>' \
	'  </bookmark>' \
	'</xbel>' > "$SHOWCASE_RECENT_DATA/recently-used.xbel"
XDG_DATA_HOME=$SHOWCASE_RECENT_DATA
export XDG_DATA_HOME
printf '%s\n' \
	'printf "\033[1;34mGTKDialog embedded VTE\033[0m\n"' \
	'printf "shell pid: %s\n" "$$"' \
	'printf "working directory: "' \
	'pwd' \
	'uname -srm' > "$SHOWCASE_TERMINAL_DEMO"
printf '%s\n' 'exit' > "$SHOWCASE_TERMINAL_EXIT"
cp "$SHOWCASE_TERMINAL_DEMO" "$SHOWCASE_TERMINAL_FEED"
printf '%s\n' 'The initial shell is running' > "$SHOWCASE_TERMINAL_STATUS"
printf '%s\n' icon:dialog-information > "$SHOWCASE_STATUS_ICON_INPUT"
printf '%s\n' \
	'#!/bin/sh' \
	'socket_id=$1' \
	'gtkdialog_bin=$2' \
	'SHOWCASE_PLUG_DIALOG="<plug socket-id=\"$socket_id\" title=\"GTKDialog XEmbed plug\"><vbox border-width=\"12\" spacing=\"10\"><text><label>Native GtkPlug client</label></text><entry><default>Editable content from a second gtkdialog process</default><variable>SHOWCASE_PLUG_TEXT</variable></entry><hbuttonbox layout-style=\"end\"><button cancel></button></hbuttonbox></vbox><action>echo \"GtkPlug attached to $socket_id\"</action><variable>SHOWCASE_PLUG_DIALOG</variable></plug>"' \
	'export SHOWCASE_PLUG_DIALOG' \
	'exec "$gtkdialog_bin" --program=SHOWCASE_PLUG_DIALOG' \
	> "$SHOWCASE_PLUG_LAUNCHER"
chmod +x "$SHOWCASE_PLUG_LAUNCHER"
trap 'rm -f -- "$SHOWCASE_SCROLL_LOG" "$SHOWCASE_STATE_RESULT" "$SHOWCASE_CHOOSER_INPUT" "$SHOWCASE_CHOOSER_STATUS" "$SHOWCASE_ICON_LIST" "$SHOWCASE_ICON_COMMAND_OUTPUT" "$SHOWCASE_ICON_FILE_OUTPUT" "$SHOWCASE_MENU_STATE" "$SHOWCASE_MENU_OUTPUT" "$SHOWCASE_TOOL_OUTPUT" "$SHOWCASE_MENU_STATUS" "$SHOWCASE_RECENT_DOCUMENT" "$SHOWCASE_RECENT_DATA/recently-used.xbel" "$SHOWCASE_TERMINAL_DEMO" "$SHOWCASE_TERMINAL_EXIT" "$SHOWCASE_TERMINAL_FEED" "$SHOWCASE_TERMINAL_STATUS" "$SHOWCASE_STATUS_ICON_INPUT" "$SHOWCASE_STATUS_ICON_OUTPUT" "$SHOWCASE_PLUG_LAUNCHER"; rmdir "$SHOWCASE_RECENT_DATA" 2>/dev/null || :' 0

SHOWCASE_WIDGET_CONTEXT_MENU='
<popupmenu>
	<menuitem stock-id="gtk-clear">
		<label>Clear the entry</label>
		<action>clear:SHOWCASE_CONTEXT_ENTRY</action>
	</menuitem>
	<menuitem stock-id="gtk-refresh">
		<label>Restore its initial text</label>
		<action>refresh:SHOWCASE_CONTEXT_ENTRY</action>
	</menuitem>
	<menuitemseparator></menuitemseparator>
	<menuitem stock-id="gtk-edit">
		<label>Focus the entry</label>
		<action>grabfocus:SHOWCASE_CONTEXT_ENTRY</action>
	</menuitem>
</popupmenu>
'

SHOWCASE_TREE_CONTEXT_MENU='
<popupmenu>
	<menuitem stock-id="gtk-add">
		<label>Expand all rows</label>
		<action>expandall:SHOWCASE_CONTEXT_TREE</action>
	</menuitem>
	<menuitem stock-id="gtk-remove">
		<label>Collapse all rows</label>
		<action>collapseall:SHOWCASE_CONTEXT_TREE</action>
	</menuitem>
	<menuitemseparator></menuitemseparator>
	<menuitem stock-id="gtk-delete">
		<label>Remove selected row</label>
		<action>removeselected:SHOWCASE_CONTEXT_TREE</action>
	</menuitem>
</popupmenu>
'

SHOWCASE_JSON_CONTEXT_MENU='
<popupmenu>
	<menuitem stock-id="gtk-add">
		<label>Expand complete hierarchy</label>
		<action>expandall:SHOWCASE_JSON_TREE</action>
	</menuitem>
	<menuitem stock-id="gtk-remove">
		<label>Collapse complete hierarchy</label>
		<action>collapseall:SHOWCASE_JSON_TREE</action>
	</menuitem>
	<menuitemseparator></menuitemseparator>
	<menuitem stock-id="gtk-save">
		<label>Save hierarchy as JSON</label>
		<action>save:SHOWCASE_JSON_TREE</action>
	</menuitem>
</popupmenu>
'
export SHOWCASE_WIDGET_CONTEXT_MENU SHOWCASE_TREE_CONTEXT_MENU
export SHOWCASE_JSON_CONTEXT_MENU

SHOWCASE_STATUS_ICON_MENU='
<popupmenu>
	<menuitem stock-id="gtk-home">
		<label>Present showcase</label>
		<action>presentwindow:MAIN_DIALOG</action>
	</menuitem>
	<menuitem stock-id="gtk-save">
		<label>Save current source</label>
		<action>save:SHOWCASE_STATUS_ICON</action>
	</menuitem>
	<menuitemseparator></menuitemseparator>
	<menuitem stock-id="gtk-quit">
		<label>Quit showcase</label>
		<action>exit:Quit</action>
	</menuitem>
</popupmenu>
'
export SHOWCASE_STATUS_ICON_MENU

SHOWCASE_TREE_ATTRIBUTES=
SHOWCASE_TREE_ROWS='<item>Review changes|Ada|true|100|0|Primary+r|false</item>
					<item>Run GTK2 checks|Linus|true|72.5|2|Primary+t|true</item>
					<item>Prepare package|Grace|false|38|1|Primary+p|true</item>
					<item>Publish release|Margaret|false|0|0|Primary+u|false</item>'

if "$GTKDIALOG" --version 2>/dev/null | grep -q 'JSON-GLib'; then
	SHOWCASE_JSON_PAGE='
			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>This separate tree is loaded from versioned JSON. Expand the release row to inspect nested children.</label></text>
				</infobar>
				<tree show-expanders="true" headers-visible="true" rules-hint="true"
					context-menu="SHOWCASE_JSON_CONTEXT_MENU"
					column-renderer="icon-text|combo|toggle|progress|spin|accel|spinner|color"
					column-editable="true|true|true|false|true|true|false|false"
					column-type="string|string|string|double|int64|string|string|string"
					column-sizing="190|90|70|85|72|115|60|75"
					column-spin-min="0|0|0|0|0" column-spin-max="100|100|100|100|10"
					column-spin-step="1|1|1|1|1" column-spin-digits="0|0|0|0|0"
					column-spin-climb-rate="||||0.5|||"
					column-spinner-size="||||||small-toolbar|"
					column-color-width="|||||||48" column-color-height="|||||||14"
					exported-column="0" space-expand="true" space-fill="true">
					<variable>SHOWCASE_JSON_TREE</variable>
					<label>Nested item|Owner|Enabled|Progress|Retries|Shortcut|Busy|Accent</label>
					<item combo-column="1">Ada</item>
					<item combo-column="1">Linus</item>
					<item combo-column="1">Grace</item>
					<item combo-column="1">Margaret</item>
					<input file format="json">'"$script_dir"'/showcase_tree.json</input>
					<output file format="json">'"$SHOWCASE_JSON_OUTPUT"'</output>
					<action signal="changed">echo "JSON tree: $SHOWCASE_JSON_TREE"</action>
					<action signal="cell-edited">echo "JSON tree edited: $SHOWCASE_JSON_TREE"</action>
					<action signal="cell-toggled">echo "JSON tree toggled: $SHOWCASE_JSON_TREE"</action>
				</tree>
				<hbuttonbox layout-style="center" spacing="8" space-expand="false">
					<button><label>Expand all</label><action>expandall:SHOWCASE_JSON_TREE</action></button>
					<button><label>Collapse all</label><action>collapseall:SHOWCASE_JSON_TREE</action></button>
				</hbuttonbox>
				<hbuttonbox layout-style="center" spacing="8" space-expand="false">
					<button><label>Remove selected row</label><action>removeselected:SHOWCASE_JSON_TREE</action></button>
					<button><label>Clear tree</label><action>clear:SHOWCASE_JSON_TREE</action></button>
					<button><label>Reload JSON</label><action>refresh:SHOWCASE_JSON_TREE</action></button>
					<button><label>Save hierarchy as JSON</label><action>save:SHOWCASE_JSON_TREE</action></button>
				</hbuttonbox>
			</vbox>'
else
	SHOWCASE_JSON_PAGE='
			<vbox border-width="10" spacing="10">
				<infobar message-type="warning">
					<text><label>This gtkdialog binary was built without JSON-GLib; rebuild with JSON-GLib to activate the nested tree below.</label></text>
				</infobar>
				<frame>
					<edit editable="false" space-expand="true" space-fill="true">
						<input file>'"$script_dir"'/showcase_tree.json</input>
						<variable export="false">SHOWCASE_JSON_SOURCE</variable>
					</edit>
					<label>JSON source file used by the hierarchical input directive</label>
				</frame>
			</vbox>'
fi
export SHOWCASE_JSON_PAGE

if "$GTKDIALOG" --version 2>/dev/null | grep -q 'VTE'; then
	SHOWCASE_TERMINAL_PAGE='
			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>The legacy VTE widget exposes its child PID. Clear resets an active screen and starts a new shell only after the previous child exits.</label></text>
				</infobar>
				<terminal argv0="/bin/sh" current-directory-uri="'"$script_dir"'"
					font-name="Monospace 9" text-background-color="#1d2021"
					text-foreground-color="#ebdbb2" cursor-background-color="#fabd2f"
					hscrollbar-policy="2" vscrollbar-policy="1"
					space-expand="true" space-fill="true">
					<width>96</width>
					<height>22</height>
					<input file>'"$SHOWCASE_TERMINAL_FEED"'</input>
					<variable>SHOWCASE_TERMINAL</variable>
					<action signal="child-exited">printf "%s\n" "Child exited; terminal PID is $SHOWCASE_TERMINAL" > "$SHOWCASE_TERMINAL_STATUS"</action>
					<action signal="child-exited">refresh:SHOWCASE_TERMINAL_STATUS_VIEW</action>
				</terminal>
				<hbuttonbox layout-style="center" spacing="8" space-expand="false">
					<button>
						<label>Send sample commands</label>
						<action>cp "$SHOWCASE_TERMINAL_DEMO" "$SHOWCASE_TERMINAL_FEED"</action>
						<action>refresh:SHOWCASE_TERMINAL</action>
					</button>
					<button>
						<label>Clear active screen</label>
						<action>clear:SHOWCASE_TERMINAL</action>
					</button>
					<button>
						<label>Exit child</label>
						<action>cp "$SHOWCASE_TERMINAL_EXIT" "$SHOWCASE_TERMINAL_FEED"</action>
						<action>refresh:SHOWCASE_TERMINAL</action>
					</button>
					<button>
						<label>Clear / restart</label>
						<action>clear:SHOWCASE_TERMINAL</action>
						<action>printf "%s\n" "Clear requested; terminal PID is $SHOWCASE_TERMINAL" > "$SHOWCASE_TERMINAL_STATUS"</action>
						<action>refresh:SHOWCASE_TERMINAL_STATUS_VIEW</action>
					</button>
				</hbuttonbox>
				<entry editable="false">
					<input file>'"$SHOWCASE_TERMINAL_STATUS"'</input>
					<variable>SHOWCASE_TERMINAL_STATUS_VIEW</variable>
				</entry>
			</vbox>'
else
	SHOWCASE_TERMINAL_PAGE='
			<vbox border-width="10" spacing="10">
				<infobar message-type="warning">
					<text><label>This gtkdialog binary was built without VTE; rebuild with GTK2 VTE support to activate the embedded terminal.</label></text>
				</infobar>
				<text><label>The terminal page is optional and does not affect the GTK2-only core.</label></text>
			</vbox>'
fi
export SHOWCASE_TERMINAL_PAGE

