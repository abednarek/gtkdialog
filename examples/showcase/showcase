						</colorselection>
						<label>Embedded selector with palette and opacity</label>
					</frame>
					<frame>
						<vbox border-width="10" spacing="12">
							<text><label>Solid colour exports #rrggbb</label></text>
							<colorbutton use-alpha="false">
								<default>#78a641</default>
								<variable>SHOWCASE_SOLID_COLOR</variable>
							</colorbutton>
							<text><label>Opacity exports #rrggbb|alpha</label></text>
							<colorbutton use-alpha="true">
								<default>#4f81bd|49152</default>
								<variable>SHOWCASE_COMPACT_COLOR</variable>
							</colorbutton>
							<button><label>Print all values</label><action>echo "Full: $SHOWCASE_FULL_COLOR · solid: $SHOWCASE_SOLID_COLOR · compact alpha: $SHOWCASE_COMPACT_COLOR"</action></button>
						</vbox>
						<label>Compact alternatives</label>
					</frame>
					<variable>SHOWCASE_COLOR_DIVIDER</variable>
				</hpaned>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>GtkFontSelection embeds the native GTK2 family, face, size and preview controls. GtkFontButton remains the compact form control.</label></text>
				</infobar>
				<hpaned position="650" child1-resize="true" child1-shrink="false"
					child2-resize="true" child2-shrink="false"
					space-expand="true" space-fill="true">
					<frame>
						<fontselection font-name="Sans 12"
							preview-text="GTKDialog native GTK2 font preview">
							<variable>SHOWCASE_FULL_FONT</variable>
							<action>echo "Selected font: $SHOWCASE_FULL_FONT"</action>
						</fontselection>
						<label>Embedded family, face and size selector</label>
					</frame>
					<frame>
						<vbox border-width="10" spacing="12">
							<text><label>Compact button with font preview</label></text>
							<fontbutton font-name="Sans 12" use-font="true"
								show-style="true" show-size="true">
								<variable>SHOWCASE_COMPACT_FONT</variable>
							</fontbutton>
							<text><label>Compact button with font and size preview</label></text>
							<fontbutton font-name="Serif Bold 14" use-font="true"
								use-size="true" show-style="true" show-size="true">
								<variable>SHOWCASE_SIZED_FONT</variable>
							</fontbutton>
							<button><label>Print all values</label><action>echo "Full: $SHOWCASE_FULL_FONT · compact: $SHOWCASE_COMPACT_FONT · sized: $SHOWCASE_SIZED_FONT"</action></button>
						</vbox>
						<label>Compact alternatives</label>
					</frame>
					<variable>SHOWCASE_FONT_DIVIDER</variable>
				</hpaned>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>GtkHSV exposes the native GTK2 hue ring and saturation/value triangle. Values use the stable H|S|V format with every component from 0 to 1.</label></text>
				</infobar>
				<hpaned position="590" child1-resize="true" child1-shrink="false"
					child2-resize="true" child2-shrink="false"
					space-expand="true" space-fill="true">
					<frame>
						<hsv hsv-size="370" ring-width="42">
							<default>0.58|0.75|0.9</default>
							<variable>SHOWCASE_HSV</variable>
							<action>refresh:SHOWCASE_HSV_VALUE</action>
						</hsv>
						<label>Large selector: 370 px / 42 px ring</label>
					</frame>
					<frame>
						<vbox border-width="10" spacing="10">
							<text><label>Current locale-independent value</label></text>
							<entry editable="false">
								<variable>SHOWCASE_HSV_VALUE</variable>
								<default>0.58|0.75|0.9</default>
								<input>printf "%s" "$SHOWCASE_HSV"</input>
							</entry>
							<text><label>A second selector can use independent native metrics.</label></text>
							<hsv hsv-size="150" ring-width="16">
								<default>0.08|0.85|0.95</default>
								<variable>SHOWCASE_HSV_COMPACT</variable>
							</hsv>
							<hbuttonbox layout-style="spread" spacing="8">
								<button><label>Print values</label><action>echo "HSV: $SHOWCASE_HSV · compact: $SHOWCASE_HSV_COMPACT"</action></button>
								<button><label>Clear main</label><action>clear:SHOWCASE_HSV</action><action>refresh:SHOWCASE_HSV_VALUE</action></button>
							</hbuttonbox>
						</vbox>
						<label>Value and compact variant</label>
					</frame>
					<variable>SHOWCASE_HSV_DIVIDER</variable>
				</hpaned>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>GtkCurve edits sampled transfer functions. The centre editor also exposes the native GtkGammaCurve spline, linear, free, gamma and reset controls.</label></text>
				</infobar>
				<hbox homogeneous="true" spacing="8" space-expand="true" space-fill="true">
					<frame>
						<vbox border-width="8" spacing="6">
							<curve curve-type="linear" min-x="0" max-x="100"
								min-y="0" max-y="1" samples="7" height-request="230">
								<variable>SHOWCASE_CURVE_LINEAR</variable>
								<default>0|0.12|0.3|0.5|0.7|0.88|1</default>
								<output file>'"$SHOWCASE_CURVE_LINEAR_OUTPUT"'</output>
								<action>refresh:SHOWCASE_CURVE_LINEAR_VALUE</action>
							</curve>
							<entry editable="false">
								<variable>SHOWCASE_CURVE_LINEAR_VALUE</variable>
								<input>printf "%s" "$SHOWCASE_CURVE_LINEAR"</input>
								<default>0|0.12|0.3|0.5|0.7|0.88|1</default>
							</entry>
							<hbuttonbox layout-style="spread" spacing="6">
								<button><label>Reset</label><action>clear:SHOWCASE_CURVE_LINEAR</action><action>refresh:SHOWCASE_CURVE_LINEAR_VALUE</action></button>
								<button><label>Save</label><action>save:SHOWCASE_CURVE_LINEAR</action></button>
							</hbuttonbox>
						</vbox>
						<label>Linear · X range 0..100 · 7 samples</label>
					</frame>
					<frame>
						<vbox border-width="8" spacing="6">
							<curve controls="true" curve-type="spline" gamma="2.2" samples="9"
								height-request="230">
								<variable>SHOWCASE_CURVE_SPLINE</variable>
								<output file>'"$SHOWCASE_CURVE_SPLINE_OUTPUT"'</output>
								<action>refresh:SHOWCASE_CURVE_SPLINE_VALUE</action>
								<action signal="curve-type-changed">refresh:SHOWCASE_CURVE_SPLINE_VALUE</action>
							</curve>
							<entry editable="false">
								<variable>SHOWCASE_CURVE_SPLINE_VALUE</variable>
								<input>printf "%s" "$SHOWCASE_CURVE_SPLINE"</input>
								<default>0|0.389|0.533|0.64|0.73|0.808|0.877|0.941|1</default>
							</entry>
							<hbuttonbox layout-style="spread" spacing="6">
								<button><label>Reset</label><action>clear:SHOWCASE_CURVE_SPLINE</action><action>refresh:SHOWCASE_CURVE_SPLINE_VALUE</action></button>
								<button><label>Save</label><action>save:SHOWCASE_CURVE_SPLINE</action></button>
							</hbuttonbox>
						</vbox>
						<label>Native controls · gamma 2.2 · 9 samples</label>
					</frame>
					<frame>
						<vbox border-width="8" spacing="6">
							<curve curve-type="free" min-y="-1" max-y="1"
								samples="9" height-request="230">
								<variable>SHOWCASE_CURVE_FREE</variable>
								<default>0|0.7|1|0.7|0|-0.7|-1|-0.7|0</default>
								<output file>'"$SHOWCASE_CURVE_FREE_OUTPUT"'</output>
								<action>refresh:SHOWCASE_CURVE_FREE_VALUE</action>
							</curve>
							<entry editable="false">
								<variable>SHOWCASE_CURVE_FREE_VALUE</variable>
								<input>printf "%s" "$SHOWCASE_CURVE_FREE"</input>
								<default>0|0.7|1|0.7|0|-0.7|-1|-0.7|0</default>
							</entry>
							<hbuttonbox layout-style="spread" spacing="6">
								<button><label>Reset</label><action>clear:SHOWCASE_CURVE_FREE</action><action>refresh:SHOWCASE_CURVE_FREE_VALUE</action></button>
								<button><label>Save</label><action>save:SHOWCASE_CURVE_FREE</action></button>
							</hbuttonbox>
						</vbox>
						<label>Free · Y range -1..1 · 9 samples</label>
					</frame>
				</hbox>
				<text><label>Each Save button writes the complete locale-independent vector to its own temporary output file.</label></text>
			</vbox>

			<vbox border-width="10" spacing="10">
				<infobar message-type="info">
					<text><label>GtkStatusIcon lives in the desktop notification area rather than inside this window. Its zero-size logical widget keeps normal gtkdialog variables, state actions and window ownership.</label></text>
				</infobar>
				<statusicon title="GTKDialog GTK2 showcase"
					tooltip-markup="&lt;b&gt;GTKDialog GTK2 showcase&lt;/b&gt;\nLeft click to present; right click for actions"
					context-menu="SHOWCASE_STATUS_ICON_MENU">
					<variable>SHOWCASE_STATUS_ICON</variable>
					<input file>'"$SHOWCASE_STATUS_ICON_INPUT"'</input>
					<output file>'"$SHOWCASE_STATUS_ICON_OUTPUT"'</output>
					<action>presentwindow:MAIN_DIALOG</action>
					<action signal="popup-menu">echo "Status icon popup requested"</action>
				</statusicon>
				<frame>
					<grid rows="5" columns="2" row-spacing="8" column-spacing="14"
						border-width="10" space-expand="true" space-fill="true">
						<text row="0" column="0"><label>Current source</label></text>
						<entry row="0" column="1" editable="false">
							<variable>SHOWCASE_STATUS_ICON_SOURCE</variable>
							<input>cat "$SHOWCASE_STATUS_ICON_INPUT"</input>
						</entry>
						<button row="1" column="0"><label>Theme icon</label><input file stock="gtk-info"></input><action>printf icon:dialog-information > "$SHOWCASE_STATUS_ICON_INPUT"</action><action>refresh:SHOWCASE_STATUS_ICON</action><action>refresh:SHOWCASE_STATUS_ICON_SOURCE</action></button>
						<button row="1" column="1"><label>Stock warning</label><input file stock="gtk-dialog-warning"></input><action>printf stock:gtk-dialog-warning > "$SHOWCASE_STATUS_ICON_INPUT"</action><action>refresh:SHOWCASE_STATUS_ICON</action><action>refresh:SHOWCASE_STATUS_ICON_SOURCE</action></button>
						<button row="2" column="0"><label>Project image file</label><input file stock="gtk-open"></input><action>printf "file:%s" "$SHOWCASE_IMAGE" > "$SHOWCASE_STATUS_ICON_INPUT"</action><action>refresh:SHOWCASE_STATUS_ICON</action><action>refresh:SHOWCASE_STATUS_ICON_SOURCE</action></button>
						<button row="2" column="1"><label>Clear image</label><input file stock="gtk-clear"></input><action>clear:SHOWCASE_STATUS_ICON</action></button>
						<accellabel row="3" column="0" column-span="2"
							accel-widget="SHOWCASE_QUIT_ITEM" xalign="0">
							<label>File → Quit keyboard accelerator</label>
							<variable>SHOWCASE_ACCEL_LABEL</variable>
						</accellabel>
						<hbuttonbox row="4" column="0" column-span="2" layout-style="spread" spacing="8">
							<button><label>Hide</label><action>hide:SHOWCASE_STATUS_ICON</action></button>
							<button><label>Show</label><action>show:SHOWCASE_STATUS_ICON</action></button>
							<button><label>Activate</label><action>activate:SHOWCASE_STATUS_ICON</action></button>
							<button><label>Save source</label><action>save:SHOWCASE_STATUS_ICON</action></button>
						</hbuttonbox>
					</grid>
					<label>Status icon sources, state actions and a native accelerator label</label>
				</frame>
				<text><label>The visible tray icon depends on the active desktop notification-area host. Right-click it to exercise the positioned popup menu.</label></text>
			</vbox>
		</notebook>

		<hbuttonbox layout-style="end" spacing="8" border-width="8"
			space-expand="false" space-fill="true">
			<button>
				<label>Guided setup</label>
				<input file stock="gtk-execute"></input>
				<action>launch:SHOWCASE_ASSISTANT</action>
			</button>
			<button>
				<label>Custom dialog</label>
				<input file stock="gtk-properties"></input>
				<action>launch:SHOWCASE_DIALOG</action>
			</button>
			<button>
				<label>Show question</label>
				<input file stock="gtk-dialog-question"></input>
				<action>launch:SHOWCASE_MESSAGE</action>
			</button>
			<button cancel></button>
			<button ok></button>
		</hbuttonbox>
		<statusbar has-resize-grip="true" space-expand="false" space-fill="true">
			<label>Ready — native GTK2 widgets in one application</label>
		</statusbar>
	</vbox>
</window>
'
export MAIN_DIALOG

case $1 in
	-d | --dump) printf '%s\n' "$MAIN_DIALOG" ;;
	*)
		"$GTKDIALOG" --styles="$script_dir/showcase.gtkrc" \
			--program=SHOWCASE_OFFSCREEN_SEED >/dev/null || exit 1
		if [ "$SHOWCASE_HAVE_GDL" = true ]; then
			"$GTKDIALOG" --styles="$script_dir/showcase.gtkrc" \
				--program=SHOWCASE_DOCK_SEED >/dev/null 2>&1 || :
		fi
		"$GTKDIALOG" --styles="$script_dir/showcase.gtkrc" --program=MAIN_DIALOG
		;;
esac
