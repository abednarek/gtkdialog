						</menu>
						<menu label="_Mode" use-underline="true">
							<menuitem radiobutton="true"><label>Compact</label><variable>SHOWCASE_MENU_COMPACT</variable></menuitem>
							<menuitem radiobutton="false"><label>Detailed</label><variable>SHOWCASE_MENU_DETAILED</variable></menuitem>
						</menu>
						<menu label="_Conditions" use-underline="true">
							<menuitem label="Report monitored option">
								<action condition="active_is_true(SHOWCASE_MENU_FILE)">printf "%s\n" "Conditional menu action: enabled" > "$SHOWCASE_MENU_STATUS"</action>
								<action condition="active_is_false(SHOWCASE_MENU_FILE)">printf "%s\n" "Conditional menu action: disabled" > "$SHOWCASE_MENU_STATUS"</action>
								<action>refresh:SHOWCASE_MENU_STATUS_VIEW</action>
							</menuitem>
						</menu>
					</menubar>
					<label>Check and radio menu items</label>
				</frame>
				<frame space-expand="false" space-fill="true">
					<toolbar toolbar-style="both" show-arrow="true" icon-size="2">
						<toggletoolbutton stock-id="gtk-yes" file-monitor="true" auto-refresh="true">
							<label>Shared file state</label>
							<variable>SHOWCASE_TOOL_FILE</variable>
							<input file>'"$SHOWCASE_MENU_STATE"'</input>
							<output file>'"$SHOWCASE_TOOL_OUTPUT"'</output>
							<action condition="active_is_true(SHOWCASE_TOOL_FILE)">printf "%s\n" "Conditional tool action: enabled" > "$SHOWCASE_MENU_STATUS"</action>
							<action condition="active_is_false(SHOWCASE_TOOL_FILE)">printf "%s\n" "Conditional tool action: disabled" > "$SHOWCASE_MENU_STATUS"</action>
							<action>refresh:SHOWCASE_MENU_STATUS_VIEW</action>
						</toggletoolbutton>
						<separatortoolitem></separatortoolitem>
						<toolbutton stock-id="gtk-refresh">
							<label>Reload command</label>
							<action>refresh:SHOWCASE_MENU_COMMAND</action>
						</toolbutton>
						<toolbutton stock-id="gtk-info">
							<label>Pointer signal</label>
							<action signal="button-press-event">printf "%s\n" "GtkWidget button-press-event received" > "$SHOWCASE_MENU_STATUS"</action>
							<action signal="button-press-event">refresh:SHOWCASE_MENU_STATUS_VIEW</action>
						</toolbutton>
					</toolbar>
					<label>Toggle tool input and a generic widget signal</label>
				</frame>
				<hbuttonbox layout-style="center" spacing="8" space-expand="false">
					<button>
						<label>Write true</label>
						<action>printf "%s\n" true > "$SHOWCASE_MENU_STATE"</action>
					</button>
					<button>
						<label>Write false</label>
						<action>printf "%s\n" false > "$SHOWCASE_MENU_STATE"</action>
					</button>
					<button>
						<label>Reload file inputs</label>
						<action>refresh:SHOWCASE_MENU_FILE</action>
						<action>refresh:SHOWCASE_TOOL_FILE</action>
					</button>
					<button>
						<label>Save both states</label>
						<action>save:SHOWCASE_MENU_FILE</action>
						<action>save:SHOWCASE_TOOL_FILE</action>
					</button>
				</hbuttonbox>
				<entry editable="false" space-expand="false">
					<input file>'"$SHOWCASE_MENU_STATUS"'</input>
					<variable>SHOWCASE_MENU_STATUS_VIEW</variable>
				</entry>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>Expand and collapse groups; exclusive groups close one another and retain normal tool-item actions.</label></text>
				</infobar>
				<scrolledwindow hscrollbar-policy="never"
					vscrollbar-policy="automatic" shadow-type="in"
					space-expand="true" space-fill="true">
					<toolpalette orientation="vertical" toolbar-style="both">
						<toolitemgroup exclusive="true" expand="true">
							<toolbutton stock-id="gtk-new"><label>New project</label><action>echo "Palette New"</action></toolbutton>
							<toolbutton stock-id="gtk-open"><label>Open project</label><action>echo "Palette Open"</action></toolbutton>
							<toolbutton stock-id="gtk-save" palette-new-row="true"><label>Save project</label><action>echo "Palette Save"</action></toolbutton>
							<label>Project</label>
							<variable>SHOWCASE_PROJECT_TOOLS</variable>
						</toolitemgroup>
						<toolitemgroup exclusive="true" collapsed="false">
							<toggletoolbutton stock-id="gtk-bold"><label>Bold</label><variable>SHOWCASE_PALETTE_BOLD</variable></toggletoolbutton>
							<toggletoolbutton stock-id="gtk-italic"><label>Italic</label><variable>SHOWCASE_PALETTE_ITALIC</variable></toggletoolbutton>
							<toolbutton stock-id="gtk-justify-left" palette-new-row="true"><label>Align left</label></toolbutton>
							<label>Formatting</label>
							<variable>SHOWCASE_FORMAT_TOOLS</variable>
						</toolitemgroup>
						<toolitemgroup exclusive="true" collapsed="true" header-relief="half">
							<radiotoolbutton stock-id="gtk-sort-ascending"><label>Ascending</label><default>true</default><variable>SHOWCASE_PALETTE_ASC</variable></radiotoolbutton>
							<radiotoolbutton stock-id="gtk-sort-descending"><label>Descending</label><variable>SHOWCASE_PALETTE_DESC</variable></radiotoolbutton>
							<menutoolbutton stock-id="gtk-go-down" palette-new-row="true">
								<menuitem label="Local"></menuitem>
								<menuitem label="Archive"></menuitem>
								<label>Destination</label>
							</menutoolbutton>
							<toolitem homogeneous="false" palette-fill="true" palette-new-row="true">
								<entry><default>Tool item child</default><variable>SHOWCASE_PALETTE_ENTRY</variable></entry>
							</toolitem>
							<label>Sorting and destination</label>
							<variable>SHOWCASE_DESTINATION_TOOLS</variable>
						</toolitemgroup>
						<variable>SHOWCASE_TOOL_PALETTE</variable>
					</toolpalette>
				</scrolledwindow>
			</vbox>

			'"$SHOWCASE_TERMINAL_PAGE"'

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>Direct GtkSocket hosts arbitrary XEmbed clients; GtkPlug lets a second gtkdialog process become a client.</label></text>
				</infobar>
				<hbox homogeneous="true" spacing="10" space-expand="true" space-fill="true">
					<frame>
						<socket width-request="400" height-request="280">
							<variable>SHOWCASE_SOCKET_ID</variable>
							<action>echo "External client attached to $SHOWCASE_SOCKET_ID"</action>
							<action signal="plug-removed">echo "External client detached from $SHOWCASE_SOCKET_ID"</action>
						</socket>
						<label>Reusable host for xterm or another XEmbed client</label>
					</frame>
					<frame>
						<socket width-request="400" height-request="280">
							<variable>SHOWCASE_PLUG_SOCKET_ID</variable>
							<action signal="realize">sh "$SHOWCASE_PLUG_LAUNCHER" "$SHOWCASE_PLUG_SOCKET_ID" "$SHOWCASE_GTKDIALOG" &</action>
							<action>echo "Gtkdialog plug attached to $SHOWCASE_PLUG_SOCKET_ID"</action>
							<action signal="plug-removed">echo "Gtkdialog plug detached from $SHOWCASE_PLUG_SOCKET_ID"</action>
						</socket>
						<label>GtkPlug client in a second gtkdialog process</label>
					</frame>
				</hbox>
				<hbuttonbox layout-style="center" spacing="8" space-expand="false">
					<button>
						<label>Start xterm if installed</label>
						<input file stock="gtk-execute"></input>
						<action>xterm -into $SHOWCASE_SOCKET_ID -title Gtkdialog-XEmbed-showcase &</action>
					</button>
					<button>
						<label>Restart gtkdialog plug</label>
						<input file stock="gtk-execute"></input>
						<action>sh "$SHOWCASE_PLUG_LAUNCHER" "$SHOWCASE_PLUG_SOCKET_ID" "$SHOWCASE_GTKDIALOG" &</action>
					</button>
					<button>
						<label>Print socket ID</label>
						<action>echo "Socket ID: $SHOWCASE_SOCKET_ID"</action>
					</button>
				</hbuttonbox>
				<text><label>Each host survives client removal. The host and plug remain separate processes with independent lifecycle and output.</label></text>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info" default-response="ok">
					<text><label>Information bars remain inside the parent window and may expose named response values.</label></text>
					<button response="ok"><label>Understood</label></button>
					<variable>SHOWCASE_INFO_DEMO</variable>
					<action>echo "Info response: $SHOWCASE_INFO_DEMO"</action>
				</infobar>
				<infobar message-type="warning" default-response="cancel">
					<text><label>Warning: this is non-modal content, not a secondary window.</label></text>
					<button response="cancel"><label>Dismiss</label></button>
					<button response="apply"><label>Apply anyway</label></button>
					<variable>SHOWCASE_WARNING_DEMO</variable>
					<action>echo "Warning response: $SHOWCASE_WARNING_DEMO"</action>
				</infobar>
				<infobar message-type="question" default-response="yes">
					<text><label>Question bars can use standard Yes and No responses.</label></text>
					<button response="no"><label>No</label></button>
					<button response="yes"><label>Yes</label></button>
					<variable>SHOWCASE_QUESTION_DEMO</variable>
					<action>echo "Question response: $SHOWCASE_QUESTION_DEMO"</action>
				</infobar>
				<infobar message-type="error" default-response="close">
					<text><label>Error styling can report a problem without terminating the application.</label></text>
					<button response="close"><label>Close notice</label></button>
					<variable>SHOWCASE_ERROR_DEMO</variable>
					<action>echo "Error response: $SHOWCASE_ERROR_DEMO"</action>
				</infobar>
				<frame>
					<vbox border-width="8" spacing="8">
						<text><label>These buttons launch four native top-level GTK2 dialog types while the showcase remains open.</label></text>
						<hbuttonbox layout-style="spread" spacing="8">
							<button><label>Assistant</label><input file stock="gtk-execute"></input><action>launch:SHOWCASE_ASSISTANT</action></button>
							<button><label>Custom dialog</label><input file stock="gtk-properties"></input><action>launch:SHOWCASE_DIALOG</action></button>
							<button><label>Question dialog</label><input file stock="gtk-dialog-question"></input><action>launch:SHOWCASE_MESSAGE</action></button>
							<button><label>About dialog</label><input file stock="gtk-about"></input><action>launch:SHOWCASE_ABOUT</action></button>
						</hbuttonbox>
					</vbox>
					<label>Assistant, GtkDialog, GtkMessageDialog and GtkAboutDialog</label>
				</frame>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>GtkColorSelection is embedded directly with opacity and the shared palette. Compact GtkColorButton controls remain available for forms.</label></text>
				</infobar>
				<hpaned position="625" child1-resize="true" child1-shrink="false"
					child2-resize="true" child2-shrink="false"
					space-expand="true" space-fill="true">
					<frame>
						<colorselection has-opacity-control="true" has-palette="true">
							<default>#4f81bd|49152</default>
							<variable>SHOWCASE_FULL_COLOR</variable>
							<action>echo "Colour with alpha: $SHOWCASE_FULL_COLOR"</action>
						</colorselection>
						<label>Embedded selector with palette and opacity</label>
					</frame>
					<frame>
						<vbox border-width="10" spacing="12">
							<text><label>Solid colour exports #rrggbb</label></text>
							<colorbutton use-alpha="false">
								<default>#78a641</default>
								<variable>SHOWCASE_SOLID_COLOR</variable>
							</colorbutton>
							<text><label>Opacity exports #rrggbb|alpha</label></text>
							<colorbutton use-alpha="true">
								<default>#4f81bd|49152</default>
								<variable>SHOWCASE_COMPACT_COLOR</variable>
							</colorbutton>
							<button><label>Print all values</label><action>echo "Full: $SHOWCASE_FULL_COLOR · solid: $SHOWCASE_SOLID_COLOR · compact alpha: $SHOWCASE_COMPACT_COLOR"</action></button>
						</vbox>
						<label>Compact alternatives</label>
					</frame>
					<variable>SHOWCASE_COLOR_DIVIDER</variable>
				</hpaned>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>GtkFontSelection embeds the native GTK2 family, face, size and preview controls. GtkFontButton remains the compact form control.</label></text>
				</infobar>
				<hpaned position="650" child1-resize="true" child1-shrink="false"
					child2-resize="true" child2-shrink="false"
					space-expand="true" space-fill="true">
					<frame>
						<fontselection font-name="Sans 12"
							preview-text="GTKDialog native GTK2 font preview">
							<variable>SHOWCASE_FULL_FONT</variable>
							<action>echo "Selected font: $SHOWCASE_FULL_FONT"</action>
						</fontselection>
						<label>Embedded family, face and size selector</label>
					</frame>
					<frame>
						<vbox border-width="10" spacing="12">
							<text><label>Compact button with font preview</label></text>
							<fontbutton font-name="Sans 12" use-font="true"
								show-style="true" show-size="true">
								<variable>SHOWCASE_COMPACT_FONT</variable>
							</fontbutton>
							<text><label>Compact button with font and size preview</label></text>
							<fontbutton font-name="Serif Bold 14" use-font="true"
								use-size="true" show-style="true" show-size="true">
								<variable>SHOWCASE_SIZED_FONT</variable>
							</fontbutton>
							<button><label>Print all values</label><action>echo "Full: $SHOWCASE_FULL_FONT · compact: $SHOWCASE_COMPACT_FONT · sized: $SHOWCASE_SIZED_FONT"</action></button>
						</vbox>
						<label>Compact alternatives</label>
					</frame>
					<variable>SHOWCASE_FONT_DIVIDER</variable>
				</hpaned>
			</vbox>

			<vbox border-width="10" spacing="8">
				<infobar message-type="info">
					<text><label>GtkHSV exposes the native GTK2 hue ring and saturation/value triangle. Values use the stable H|S|V format with every component from 0 to 1.</label></text>
				</infobar>
				<hpaned position="590" child1-resize="true" child1-shrink="false"
					child2-resize="true" child2-shrink="false"
					space-expand="true" space-fill="true">
					<frame>
						<hsv hsv-size="370" ring-width="42">
							<default>0.58|0.75|0.9</default>
							<variable>SHOWCASE_HSV</variable>
							<action>refresh:SHOWCASE_HSV_VALUE</action>
						</hsv>
						<label>Large selector: 370 px / 42 px ring</label>
					</frame>
					<frame>
						<vbox border-width="10" spacing="10">
							<text><label>Current locale-independent value</label></text>
							<entry editable="false">
								<variable>SHOWCASE_HSV_VALUE</variable>
								<default>0.58|0.75|0.9</default>
								<input>printf "%s" "$SHOWCASE_HSV"</input>
							</entry>
							<text><label>A second selector can use independent native metrics.</label></text>
							<hsv hsv-size="150" ring-width="16">
								<default>0.08|0.85|0.95</default>
								<variable>SHOWCASE_HSV_COMPACT</variable>
							</hsv>
							<hbuttonbox layout-style="spread" spacing="8">
								<button><label>Print values</label><action>echo "HSV: $SHOWCASE_HSV · compact: $SHOWCASE_HSV_COMPACT"</action></button>
								<button><label>Clear main</label><action>clear:SHOWCASE_HSV</action><action>refresh:SHOWCASE_HSV_VALUE</action></button>
							</hbuttonbox>
						</vbox>
						<label>Value and compact variant</label>
					</frame>
					<variable>SHOWCASE_HSV_DIVIDER</variable>
				</hpaned>
			</vbox>

			<vbox border-width="10" spacing="10">
				<infobar message-type="info">
					<text><label>GtkStatusIcon lives in the desktop notification area rather than inside this window. Its zero-size logical widget keeps normal gtkdialog variables, state actions and window ownership.</label></text>
				</infobar>
				<statusicon title="GTKDialog GTK2 showcase"
					tooltip-markup="&lt;b&gt;GTKDialog GTK2 showcase&lt;/b&gt;\nLeft click to present; right click for actions"
					context-menu="SHOWCASE_STATUS_ICON_MENU">
					<variable>SHOWCASE_STATUS_ICON</variable>
					<input file>'"$SHOWCASE_STATUS_ICON_INPUT"'</input>
					<output file>'"$SHOWCASE_STATUS_ICON_OUTPUT"'</output>
					<action>presentwindow:MAIN_DIALOG</action>
					<action signal="popup-menu">echo "Status icon popup requested"</action>
				</statusicon>
				<frame>
					<grid rows="5" columns="2" row-spacing="8" column-spacing="14"
						border-width="10" space-expand="true" space-fill="true">
						<text row="0" column="0"><label>Current source</label></text>
						<entry row="0" column="1" editable="false">
							<variable>SHOWCASE_STATUS_ICON_SOURCE</variable>
							<input>cat "$SHOWCASE_STATUS_ICON_INPUT"</input>
						</entry>
						<button row="1" column="0"><label>Theme icon</label><input file stock="gtk-info"></input><action>printf icon:dialog-information > "$SHOWCASE_STATUS_ICON_INPUT"</action><action>refresh:SHOWCASE_STATUS_ICON</action><action>refresh:SHOWCASE_STATUS_ICON_SOURCE</action></button>
						<button row="1" column="1"><label>Stock warning</label><input file stock="gtk-dialog-warning"></input><action>printf stock:gtk-dialog-warning > "$SHOWCASE_STATUS_ICON_INPUT"</action><action>refresh:SHOWCASE_STATUS_ICON</action><action>refresh:SHOWCASE_STATUS_ICON_SOURCE</action></button>
						<button row="2" column="0"><label>Project image file</label><input file stock="gtk-open"></input><action>printf "file:%s" "$SHOWCASE_IMAGE" > "$SHOWCASE_STATUS_ICON_INPUT"</action><action>refresh:SHOWCASE_STATUS_ICON</action><action>refresh:SHOWCASE_STATUS_ICON_SOURCE</action></button>
						<button row="2" column="1"><label>Clear image</label><input file stock="gtk-clear"></input><action>clear:SHOWCASE_STATUS_ICON</action></button>
						<accellabel row="3" column="0" column-span="2"
							accel-widget="SHOWCASE_QUIT_ITEM" xalign="0">
							<label>File → Quit keyboard accelerator</label>
							<variable>SHOWCASE_ACCEL_LABEL</variable>
						</accellabel>
						<hbuttonbox row="4" column="0" column-span="2" layout-style="spread" spacing="8">
							<button><label>Hide</label><action>hide:SHOWCASE_STATUS_ICON</action></button>
							<button><label>Show</label><action>show:SHOWCASE_STATUS_ICON</action></button>
							<button><label>Activate</label><action>activate:SHOWCASE_STATUS_ICON</action></button>
							<button><label>Save source</label><action>save:SHOWCASE_STATUS_ICON</action></button>
						</hbuttonbox>
					</grid>
					<label>Status icon sources, state actions and a native accelerator label</label>
				</frame>
				<text><label>The visible tray icon depends on the active desktop notification-area host. Right-click it to exercise the positioned popup menu.</label></text>
			</vbox>
		</notebook>

		<hbuttonbox layout-style="end" spacing="8" border-width="8"
			space-expand="false" space-fill="true">
			<button>
				<label>Guided setup</label>
				<input file stock="gtk-execute"></input>
				<action>launch:SHOWCASE_ASSISTANT</action>
			</button>
			<button>
				<label>Custom dialog</label>
				<input file stock="gtk-properties"></input>
				<action>launch:SHOWCASE_DIALOG</action>
			</button>
			<button>
				<label>Show question</label>
				<input file stock="gtk-dialog-question"></input>
				<action>launch:SHOWCASE_MESSAGE</action>
			</button>
			<button cancel></button>
			<button ok></button>
		</hbuttonbox>
		<statusbar has-resize-grip="true" space-expand="false" space-fill="true">
			<label>Ready — native GTK2 widgets in one application</label>
		</statusbar>
	</vbox>
</window>
'
export MAIN_DIALOG

case $1 in
	-d | --dump) printf '%s\n' "$MAIN_DIALOG" ;;
	*) "$GTKDIALOG" --styles="$script_dir/showcase.gtkrc" --program=MAIN_DIALOG ;;
esac
