#!/bin/sh

[ -z "$GTKDIALOG" ] && GTKDIALOG=gtkdialog

if ! "$GTKDIALOG" --version 2>/dev/null | grep -q 'libwnck 2'; then
	echo "This example requires gtkdialog built with libwnck 2 support." >&2
	exit 1
fi

demo_dir=$(mktemp -d "${TMPDIR:-/tmp}/gtkdialog-tasklist.XXXXXX") || exit 1
trap 'rm -rf "$demo_dir"' EXIT HUP INT TERM

TASKLIST_OUTPUT=$demo_dir/active-xid
export TASKLIST_OUTPUT

MAIN_DIALOG='
<window title="GTK2 desktop task list" width-request="760" skip-taskbar-hint="true">
	<vbox border-width="8" spacing="6">
		<text use-markup="true" xalign="0">
			<label>"<b>Native X11 task list</b> — click a window button to activate it."</label>
		</text>
		<tasklist grouping="auto" grouping-limit="3"
			include-all-workspaces="true"
			switch-workspace-on-unminimize="true"
			button-relief="normal" minimum-height="32">
			<variable>ACTIVE_WINDOW_XID</variable>
			<output file>'"$TASKLIST_OUTPUT"'</output>
			<action signal="active-window-changed">echo "Active window XID: $ACTIVE_WINDOW_XID"</action>
		</tasklist>
		<hbuttonbox layout="end">
			<button>
				<label>Refresh windows</label>
				<action function="refresh">ACTIVE_WINDOW_XID</action>
			</button>
			<button>
				<label>Save active XID</label>
				<action function="save">ACTIVE_WINDOW_XID</action>
			</button>
			<button cancel></button>
		</hbuttonbox>
	</vbox>
</window>
'
export MAIN_DIALOG

case ${1:-} in
	-d | --dump) printf '%s\n' "$MAIN_DIALOG" ;;
	*) "$GTKDIALOG" --program=MAIN_DIALOG ;;
esac
