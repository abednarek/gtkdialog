#!/bin/sh

[ -z "$GTKDIALOG" ] && GTKDIALOG=gdlg2
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

MAIN_DIALOG='
<window title="Editable tree cells" width-request="440" height-request="240">
	<vbox border-width="10" spacing="8">
		<text>
			<label>Select a row, then edit its task or type an owner name for completion.</label>
		</text>
		<tree column-editable="true|true" column-completion="false|true"
			column-completion-minimum-key-length="1|1"
			completion-match="contains" completion-case-sensitive="false"
			exported-column="1">
			<variable>EDITABLE_TREE</variable>
			<label>Task|Owner</label>
			<input completion-column="1">printf "%s\n" "Ada Lovelace" "Grace Hopper"</input>
			<input file completion-column="1">'"$script_dir"'/tree_completion.txt</input>
			<item>Review changes|Ada</item>
			<item>Update documentation|Linus</item>
			<item>Prepare release|Grace</item>
			<action signal="cell-edited">echo "Edited value: $EDITABLE_TREE"</action>
		</tree>
		<hbuttonbox layout-style="end">
			<button cancel></button>
			<button ok></button>
		</hbuttonbox>
	</vbox>
</window>
'
export MAIN_DIALOG

case $1 in
	-d | --dump) printf '%s\n' "$MAIN_DIALOG" ;;
	*) "$GTKDIALOG" --program=MAIN_DIALOG ;;
esac
