# Maintainer: Artur Bednarek <artur@unix.org.pl>
pkgname=gdlg2-bundled
pkgver=0.9.2
pkgrel=1
pkgdesc='GTK2 dialog builder with private GTK2 and legacy extensions'
arch=('x86_64')
url='https://github.com/abednarek/gtkdialog'
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('json-glib' 'enchant' 'aspell' 'hspell' 'hunspell' 'hunspell-en_us'
         'libvoikko' 'nuspell' 'libxml2' 'ncurses' 'fontconfig' 'pango' 'at-spi2-core' 'cairo'
         'gdk-pixbuf2' 'glib2' 'hicolor-icon-theme' 'libx11' 'libxext'
         'libxfixes' 'libxrender' 'libxi' 'libxcursor' 'libxrandr'
         'libxcomposite' 'libxinerama' 'libxdamage' 'libxft' 'libxres')
makedepends=('autoconf' 'automake' 'libtool' 'gettext' 'intltool' 'flex'
             'bison' 'pkgconf' 'patch' 'glib2-devel')
checkdepends=('xorg-server-xvfb' 'xdotool' 'ttf-dejavu')
source=("gtkdialog-$pkgver.tar.gz::$url/releases/download/$pkgver/gtkdialog-$pkgver.tar.gz"
        "gtkdialog-$pkgver-bundled-sources.tar.gz::$url/releases/download/$pkgver/gtkdialog-$pkgver-bundled-sources.tar.gz")
sha256sums=('43b27b35c726d71a30987327ed96af99c2a1697c4417f9f78e4d008645f49041'
            'f1c7546b061b94b90ba42fd7ec3e49fff6cd9fad1a6bbda103f4fec1c1c359a4')

build() {
	"$srcdir/gtkdialog-$pkgver/bundled/build-bundle.sh" \
		"$srcdir/gtkdialog-$pkgver" "$srcdir/bundle-work" \
		"$srcdir/bundle-package" private-gtk2
}

check() {
	LD_LIBRARY_PATH="$srcdir/bundle-work/stage/opt/gldg2/lib" \
	XDG_DATA_DIRS="$srcdir/bundle-work/stage/opt/gldg2/share:/usr/local/share:/usr/share" \
		make -C "$srcdir/bundle-work/build/gtkdialog" check
}

package() {
	cp -a "$srcdir/bundle-package/." "$pkgdir/"
}
