# Maintainer: Artur Bednarek <artur@unix.org.pl>
pkgname=gdlg2
pkgver=0.9.2
pkgrel=0
pkgdesc="GTK2 dialog builder for shell scripts"
url="https://github.com/abednarek/gtkdialog"
arch="all"
license="GPL-2.0-or-later"
makedepends="build-base gtk+2.0-dev json-glib-dev pkgconf"
source="gtkdialog-$pkgver.tar.gz::$url/releases/download/$pkgver/gtkdialog-$pkgver.tar.gz"
builddir="$srcdir/gtkdialog-$pkgver"

build() {
	mkdir -p "$builddir/build"
	cd "$builddir/build"
	../configure --prefix=/usr --with-json-glib
	make
}

package() {
	make -C "$builddir/build" DESTDIR="$pkgdir" install
}

sha512sums="63fb5f2cbf4f009b3f6c3f315b9ddc2a721b951e684e0a6823a504b7ba2a63194db86f6811664bf3e4a4a0e6bc42efcabf810a9df811097041f67b5300599994  gtkdialog-$pkgver.tar.gz"
