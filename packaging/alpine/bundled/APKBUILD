a22a99ca8a857bac60acb0eeb2c9a3a0b3c5f4497bd7c5964aef6e23871d0ace12883b9e8dcc45f667277a921f9e06a8ffbc53305291418e11ffda3a93c80a06  gtkdialog-$pkgver-bundled-sources.tar.gz"
