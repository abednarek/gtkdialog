# Maintainer: Artur Bednarek <artur@unix.org.pl>
pkgname=gdlg2-bundled
pkgver=0.9.2
pkgrel=0
pkgdesc="GTK2 dialog builder with private legacy GTK2 extensions"
url="https://github.com/abednarek/gtkdialog"
arch="x86_64"
license="GPL-2.0-or-later AND LGPL-2.0-or-later AND LGPL-2.1-or-later"
depends="gtk+2.0 json-glib enchant2-libs libxml2 libncursesw"
makedepends="build-base gtk+2.0-dev json-glib-dev enchant2-dev libxml2-dev
	ncurses-dev libx11-dev cairo-dev pango-dev pkgconf gettext-dev intltool
	autoconf automake libtool flex bison patch tar"
checkdepends="xvfb-run xdotool font-dejavu"
source="gtkdialog-$pkgver.tar.gz::$url/releases/download/$pkgver/gtkdialog-$pkgver.tar.gz"
builddir="$srcdir/gtkdialog-$pkgver"

build() {
	"$builddir/bundled/build-bundle.sh" "$builddir" \
		"$srcdir/bundle-work" "$srcdir/bundle-package" system-gtk2
}

check() {
	LD_LIBRARY_PATH="$srcdir/bundle-work/stage/opt/gldg2/lib" \
	XDG_DATA_DIRS="$srcdir/bundle-work/stage/opt/gldg2/share:/usr/local/share:/usr/share" \
		make -C "$srcdir/bundle-work/build/gtkdialog" check
}

package() {
	cp -a "$srcdir/bundle-package/." "$pkgdir/"
}

sha512sums="5a4f7824a909c98cb33ea7c5b1ca52438c8968e74e36510158841deff41bd2750651bfb075a62697f2ed7cc96d4d147a9de4d6f3882e3fa2ac65433e04aa5bf2  gtkdialog-$pkgver.tar.gz"
